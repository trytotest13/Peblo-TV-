# Peblo TV Mini — root .env.example
# Copy to .env and fill in values. Never commit the real .env.

# --- Database ---
# Used by docker-compose to start the Postgres container.
# In Docker: credentials here must match the DATABASE_URL below.
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo
POSTGRES_DB=peblo_tv

# --- API ---
# JWT_SECRET must be a strong random string in production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
BOOTSTRAP_ADMIN_EMAIL=admin@peblo.local
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Database connection string (used by the FastAPI app)
DATABASE_URL=postgresql+asyncpg://peblo:peblo@localhost:5432/peblo_tv
SYNC_DATABASE_URL=postgresql+psycopg2://peblo:peblo@localhost:5432/peblo_tv

# --- CORS ---
# Allowed origins for the API (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage ---
# Options: "local" (default) | "r2"
STORAGE_BACKEND=local

# Cloudflare R2 — only required if STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Viewer ---
# Set to the official support mailbox before public launch
VITE_SUPPORT_EMAIL=
