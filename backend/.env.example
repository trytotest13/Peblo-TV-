# --- Application ---
APP_ENV=development
APP_NAME=Peblo TV Mini API
LOG_LEVEL=INFO

# --- Database ---
# Local Postgres (docker-compose default)
DATABASE_URL=postgresql+asyncpg://peblo:peblo@db:5432/peblo_tv
# For alembic / sync ops (used by migrations)
SYNC_DATABASE_URL=postgresql+psycopg2://peblo:peblo@db:5432/peblo_tv

# --- Auth ---
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Storage abstraction ---
# Options: "local" | "r2"  (only "local" is fully implemented; "r2" is stubbed for the writeup)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# When STORAGE_BACKEND=r2 these are required:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Catalog publishing ---
# Where the published catalogue JSON is served from. Must be reachable by the viewer.
CATALOG_FILENAME=catalog.json

# --- Bootstrap admin (created on first startup if no users exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@peblo.local
BOOTSTRAP_ADMIN_PASSWORD=admin123
