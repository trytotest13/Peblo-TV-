# Viewer env — copy to .env and fill in values. Never commit the real .env.
VITE_API_URL=http://localhost:8000
# CDN base for artwork URLs (no trailing slash). Leave empty to resolve /media/... against VITE_API_URL.
VITE_CDN_URL=
# Set to the official support mailbox before public launch
VITE_SUPPORT_EMAIL=
